rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile and telemetry collections
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Pro status comes from the server (Stripe + account age); clients may never write it.
      allow create: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['subscription']);
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription']);
      allow delete: if request.auth != null && request.auth.uid == userId;
      
      // Allow user full read/write to their private journal subcollection
      match /journal/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Allow user full read/write to their account connections subcollection
      match /accounts/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Allow user full read/write to their debrief audits
      match /debriefs/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Deny all other unmatched paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
